{
  "name": "remoteku",
  "version": "2.0.0",
  "description": "A Roku Remote Control Electron Application",
  "main": "main.js",
  "scripts": {
    "postinstall": "node scripts/patch_electron_plist.js",
    "prestart": "node scripts/patch_electron_plist.js",
    "start": "electron .",
    "build": "npm run build:mac",
    "prebuild:mac": "node scripts/quit_running_app_before_build.js",
    "build:mac": "electron-builder --mac --arm64",
    "dist": "electron-builder --publish never",
    "test": "node --test test/*.test.js"
  },
  "keywords": [
    "roku",
    "remote",
    "electron"
  ],
  "author": "KevinOBytes",
  "license": "ISC",
  "devDependencies": {
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0"
  },
  "dependencies": {
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/plus-jakarta-sans": "^5.3.0",
    "@fontsource/space-grotesk": "^5.3.0",
    "axios": "^1.21.0",
    "fast-xml-parser": "^5.12.0"
  },
  "build": {
    "appId": "com.kevinobytes.remoteku",
    "productName": "RemoteKu",
    "afterPack": "scripts/after_pack.js",
    "directories": {
      "output": "builds"
    },
    "files": [
      "**/*",
      "!builds/**",
      "!docs/**",
      "!.superpowers/**",
      "!test/**",
      "!tests/**",
      "!.github/**",
      "!.git/**",
      "!**/*.md",
      "!.gitignore"
    ],
    "mac": {
      "category": "public.app-category.utilities",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        }
      ],
      "identity": null,
      "entitlements": "entitlements.mac.plist",
      "extendInfo": {
        "NSLocalNetworkUsageDescription": "RemoteKu needs access to your local network to discover and control Roku devices.",
        "NSBonjourServices": [
          "_roku-ecp._tcp",
          "_ssdp._udp"
        ]
      }
    },
    "win": {
      "target": "nsis"
    },
    "linux": {
      "target": "AppImage"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "KevinOBytes",
        "repo": "remoteku"
      }
    ]
  }
}
